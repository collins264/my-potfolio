<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mama Blessing Kitchen - Contemporary Nigerian Cuisine</title>
  <style>
    :root {
      --bg: #fffdf8;
      --text: #2c1a0f;
      --primary: #8B4513;
      --accent: #FF8C00;
      --card: white;
    }
    
    [data-theme="dark"] {
      --bg: #1a1a1a;
      --text: #f5f5f5;
      --primary: #D2691E;
      --accent: #FFA500;
      --card: #2a2a2a;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }
    
    body {
      font-family: 'Georgia', serif;
      background: var(--bg);
      color: var(--text);
      transition: background 0.3s, color 0.3s;
    }
    
    nav {
      background: var(--primary);
      color: white;
      padding: 20px 10%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: fixed;
      width: 100%;
      top: 0;
      z-index: 100;
    }
    
    .theme-btn {
      background: none;
      border: 2px solid white;
      color: white;
      padding: 8px 15px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 1.2rem;
    }
    
    .hero {
      background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1606787366850-de6330128bfc?q=80&w=1000') center/cover;
      height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: white;
      padding: 0 10%;
      margin-top: 70px;
    }
    
    .hero h2 {
      font-size: 3.5rem;
      margin-bottom: 20px;
      opacity: 0;
      animation: fadeUp 1s forwards;
    }
    
    .hero p {
      font-size: 1.2rem;
      margin-bottom: 30px;
      opacity: 0;
      animation: fadeUp 1s 0.3s forwards;
    }
    
    .btn {
      background: var(--accent);
      color: white;
      padding: 15px 35px;
      border: none;
      border-radius: 8px;
      font-size: 1.1rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: transform 0.3s;
      opacity: 0;
      animation: fadeUp 1s 0.6s forwards;
    }
    
    .btn:hover {
      transform: scale(1.05);
    }
    
    section {
      padding: 80px 10%;
    }
    
    .fade-in {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s ease;
    }
    
    .fade-in.show {
      opacity: 1;
      transform: translateY(0);
    }
    
    h2.section-title {
      text-align: center;
      font-size: 2.5rem;
      color: var(--primary);
      margin-bottom: 50px;
    }
    
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 30px;
    }
    
    .menu-item {
      background: var(--card);
      border-radius: 15px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      transition: transform 0.3s;
    }
    
    .menu-item:hover {
      transform: translateY(-10px);
    }
    
    .menu-item img {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }
    
    .menu-info {
      padding: 20px;
    }
    
    .menu-info h3 {
      color: var(--primary);
      margin-bottom: 10px;
    }
    
    .price {
      color: var(--accent);
      font-weight: bold;
      font-size: 1.2rem;
    }
    
    .about {
      background: var(--card);
      text-align: center;
    }
    
    .contact {
      background: var(--primary);
      color: white;
      text-align: center;
    }
    
    .contact .btn {
      background: white;
      color: var(--primary);
    }
    
    footer {
      background: #2c1a0f;
      color: white;
      text-align: center;
      padding: 30px;
    }
    
    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    @media(max-width: 768px){
      .hero h2 { font-size: 2.2rem; }
    }
  </style>
</head>
<body>

  <nav>
    <h1>Mama Blessing Kitchen</h1>
    <button class="theme-btn" id="themeToggle">🌙</button>
  </nav>

  <section class="hero" id="home">
    <div>
      <h2>Contemporary Nigerian Native Cuisine</h2>
      <p>Taste the richness of home-cooked meals with a modern twist</p>
      <a href="#menu" class="btn">View Menu</a>
    </div>
  </section>

  <section id="menu">
    <h2 class="section-title fade-in">Our Signature Dishes</h2>
    <div class="menu-grid">
      
      <div class="menu-item fade-in">
        <img src="https://images.unsplash.com/photo-1569562211093-4ed0d0758f12?q=80&w=800" alt="Banga Soup">
        <div class="menu-info">
          <h3>Banga Soup & Starch</h3>
          <p>Authentic Delta delicacy with fresh fish and palm nut extract</p>
          <p class="price">₦4,500</p>
        </div>
      </div>

      <div class="menu-item fade-in">
        <img src="https://images.unsplash.com/photo-1604909052748-94e838986545?q=80&w=800" alt="Egusi Soup">
        <div class="menu-info">
          <h3>Egusi Soup & Pounded Yam</h3>
          <p>Melon seed soup served with smooth pounded yam</p>
          <p class="price">₦3,800</p>
        </div>
      </div>

      <div class="menu-item fade-in">
        <img src="https://images.unsplash.com/photo-1623341214825-9c8d1a3b3f1e?q=80&w=800" alt="Jollof Rice">
        <div class="menu-info">
          <h3>Party Jollof & Grilled Chicken</h3>
          <p>Smoky party jollof with suya-spiced grilled chicken</p>
          <p class="price">₦3,500</p>
        </div>
      </div>

    </div>
  </section>

  <section class="about fade-in" id="about">
    <h2 class="section-title">About Mama Blessing</h2>
    <p style="max-width: 700px; margin: 0 auto; font-size: 1.1rem; line-height: 1.8;">
      At Mama Blessing Kitchen, we blend traditional Nigerian recipes with contemporary presentation. 
      Every meal is cooked with love, fresh ingredients, and the taste of home.
    </p>
  </section>

  <section class="contact fade-in" id="contact">
    <h2 class="section-title" style="color: white;">Place Your Order</h2>
    <p style="margin-bottom: 30px;">Fill the form and we'll WhatsApp you back instantly</p>
    
    <form id="orderForm" style="max-width: 500px; margin: 0 auto;">
      <input type="text" id="name" placeholder="Your Name" required style="width:100%; padding:15px; margin:10px 0; border-radius:8px; border:none;">
      
      <input type="tel" id="phone" placeholder="Your Phone Number" required style="width:100%; padding:15px; margin:10px 0; border-radius:8px; border:none;">
      
      <select id="food" required style="width:100%; padding:15px; margin:10px 0; border-radius:8px; border:none;">
        <option value="">Select Dish</option>
        <option value="Banga Soup & Starch - ₦4,500">Banga Soup & Starch - ₦4,500</option>
        <option value="Egusi Soup & Pounded Yam - ₦3,800">Egusi Soup & Pounded Yam - ₦3,800</option>
        <option value="Party Jollof & Chicken - ₦3,500">Party Jollof & Chicken - ₦3,500</option>
      </select>
      
      <textarea id="address" placeholder="Delivery Address" rows="3" required style="width:100%; padding:15px; margin:10px 0; border-radius:8px; border:none;"></textarea>
      
      <button type="submit" class="btn">Send Order via WhatsApp</button>
    </form>
    
    <p style="margin-top: 30px;">Lagos, Nigeria | Open Mon - Sun: 9AM - 9PM</p>
  </section>

  <footer>
    <p>© 2026 Mama Blessing Kitchen. Built by Collins</p>
  </footer>

  <script>
    // DARK MODE TOGGLE
    const toggle = document.getElementById('themeToggle');
    const body = document.body;
    
    if(localStorage.getItem('theme') === 'dark') {
      body.setAttribute('data-theme', 'dark');
      toggle.textContent = '☀️';
    }
    
    toggle.addEventListener('click', () => {
      if(body.getAttribute('data-theme') === 'dark') {
        body.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        toggle.textContent = '🌙';
      } else {
        body.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        toggle.textContent = '☀️';
      }
    });

    // SCROLL ANIMATIONS
    const faders = document.querySelectorAll('.fade-in');
    const appearOptions = { threshold: 0.2 };
    
    const appearOnScroll = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if(!entry.isIntersecting) return;
        entry.target.classList.add('show');
        observer.unobserve(entry.target);
      });
    }, appearOptions);
    
    faders.forEach(fader => {
      appearOnScroll.observe(fader);
    });

    // WHATSAPP ORDER FORM
    document.getElementById('orderForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const name = document.getElementById('name').value;
      const phone = document.getElementById('phone').value;
      const food = document.getElementById('food').value;
      const address = document.getElementById('address').value;
      
      // CHANGE THIS TO MAMA BLESSING'S WHATSAPP WITH 234
      const whatsappNumber = '2348139320756';
      
      const message = `Hello Mama Blessing Kitchen!%0A%0A*New Order*%0AName: ${name}%0APhone: ${phone}%0AOrder: ${food}%0AAddress: ${address}%0A%0AThank you!`;
      
      const whatsappURL = `https://wa.me/${whatsappNumber}?text=${message}`;
      window.open(whatsappURL, '_blank');
    });
  </script>

</body>
</html>
